---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  bodyClass?: string;
}

const { title, description = SITE.description, image = '/og.png', bodyClass } = Astro.props;
const fullTitle = title ? `${title} — swiift` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07080b" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="swiift" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initFx } from '../scripts/fx';
      import { initCursor } from '../scripts/cursor';
      initFx();
      initCursor();
    </script>
  </body>
</html>

<style is:global>
  /* ---------- custom cursor ---------- */
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .cursor.is-visible {
    opacity: 1;
  }
  .cursor__dot,
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }
  .cursor__dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--accent);
    transition:
      opacity 0.2s,
      width 0.25s,
      height 0.25s,
      margin 0.25s;
  }
  .cursor__ring {
    width: 0;
    height: 0;
  }
  .cursor__shape {
    position: absolute;
    width: 36px;
    height: 36px;
    left: -18px;
    top: -18px;
    border: 1.5px solid rgb(238 242 247 / 0.55);
    border-radius: 50%;
    transition:
      width 0.35s var(--ease-out),
      height 0.35s var(--ease-out),
      left 0.35s var(--ease-out),
      top 0.35s var(--ease-out),
      background-color 0.3s,
      border-color 0.3s;
  }
  .cursor__label {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-ink);
    white-space: nowrap;
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out);
  }
  .cursor.is-hover .cursor__shape {
    width: 56px;
    height: 56px;
    left: -28px;
    top: -28px;
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .cursor.is-hover .cursor__dot {
    opacity: 0;
  }
  .cursor.has-label .cursor__shape {
    width: 76px;
    height: 76px;
    left: -38px;
    top: -38px;
    background: var(--accent);
    border-color: var(--accent);
  }
  .cursor.has-label .cursor__label {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .cursor.is-down .cursor__shape {
    width: 26px;
    height: 26px;
    left: -13px;
    top: -13px;
  }
  /* Text fields keep the native I-beam. */
  .cursor.is-text {
    opacity: 0;
  }
  .tracer {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9998;
    pointer-events: none;
  }
</style>
