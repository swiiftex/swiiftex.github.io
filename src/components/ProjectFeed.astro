---
/**
 * Every project as a dense list, filterable by category. On fine pointers a
 * preview of the hovered project floats after the cursor.
 */
import { getImage } from 'astro:assets';
import { projectHref, whenLabel, type Project } from '../lib/projects';
import { CATEGORY_LABELS } from '../data/site';
import { CATEGORIES } from '../content.config';

interface Props {
  projects: Project[];
  /** Show the category filter bar. */
  filters?: boolean;
}
const { projects, filters = true } = Astro.props;

const previews = await Promise.all(
  projects.map(async (p) =>
    p.data.cover ? (await getImage({ src: p.data.cover, width: 640, format: 'webp' })).src : null,
  ),
);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, projects.filter((p) => p.data.category === c).length]));
---

<div class="feed" data-feed>
  {
    filters && (
      <div class="feed__filters" role="toolbar" aria-label="Filter projects">
        <button type="button" class="feed__filter" data-filter="all" aria-pressed="true">
          All <span class="feed__count">{String(projects.length).padStart(2, '0')}</span>
        </button>
        {CATEGORIES.map((c) => (
          <button type="button" class="feed__filter" data-filter={c} aria-pressed="false">
            {CATEGORY_LABELS[c]} <span class="feed__count">{String(counts[c]).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
    )
  }

  <ol role="list" class="feed__list">
    {
      projects.map((p, i) => (
        <li class="feed__row" data-category={p.data.category} style={`view-transition-name:row-${p.id}`}>
          <a href={projectHref(p)} class="feed__link" data-preview={previews[i] ?? undefined} data-cursor="view">
            <span class="feed__index mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="feed__title">{p.data.title}</span>
            <span class="feed__kicker">{p.data.kicker}</span>
            <span class="feed__meta">
              <span class="feed__when mono">{whenLabel(p)}</span>
              <span class="feed__cat mono">{CATEGORY_LABELS[p.data.category]}</span>
            </span>
            {previews[i] && <img class="feed__thumb" src={previews[i]} alt="" loading="lazy" decoding="async" />}
          </a>
        </li>
      ))
    }
  </ol>
  <p class="feed__empty mono" hidden>Nothing here yet.</p>
  <div class="feed__preview" aria-hidden="true"><img alt="" /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-feed]').forEach((feed) => {
    const buttons = [...feed.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...feed.querySelectorAll<HTMLElement>('.feed__row')];
    const empty = feed.querySelector<HTMLElement>('.feed__empty')!;

    const apply = (filter: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      let shown = 0;
      rows.forEach((r) => {
        const on = filter === 'all' || r.dataset.category === filter;
        r.hidden = !on;
        if (on) shown++;
      });
      empty.hidden = shown > 0;
    };
    const choose = (filter: string) => {
      const run = () => apply(filter);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduce) document.startViewTransition(run);
      else run();
      history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
    };
    buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.filter!)));
    const initial = location.hash.slice(1);
    if (buttons.some((b) => b.dataset.filter === initial)) apply(initial);

    // ---- floating preview ----
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const preview = feed.querySelector<HTMLElement>('.feed__preview')!;
    const img = preview.querySelector('img')!;
    let x = 0,
      y = 0,
      px = 0,
      py = 0,
      raf = 0,
      active = false;
    const loop = () => {
      const dx = x - px;
      px += dx * 0.16;
      py += (y - py) * 0.16;
      const tilt = Math.max(Math.min(dx * 0.08, 8), -8);
      preview.style.transform = `translate3d(${px}px, ${py}px, 0) rotate(${tilt}deg)`;
      raf = active || Math.abs(dx) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    feed.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
      link.addEventListener('pointerenter', (e) => {
        img.src = link.dataset.preview!;
        if (!active) {
          px = x = e.clientX;
          py = y = e.clientY;
        }
        active = true;
        preview.classList.add('is-on');
        if (!raf) raf = requestAnimationFrame(loop);
      });
      link.addEventListener('pointerleave', () => {
        active = false;
        preview.classList.remove('is-on');
      });
    });
    feed.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
    });
    // Scrolling slides rows out from under a still pointer without a pointerleave.
    window.addEventListener(
      'scroll',
      () => {
        if (!active) return;
        const under = document.elementFromPoint(x, y)?.closest<HTMLAnchorElement>('[data-preview]');
        if (!under || !feed.contains(under)) {
          active = false;
          preview.classList.remove('is-on');
        } else if (under.dataset.preview !== img.getAttribute('src')) {
          img.src = under.dataset.preview!;
        }
      },
      { passive: true },
    );
  });
</script>

<style>
  .feed__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .feed__filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .feed__filter:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
  .feed__filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .feed__count {
    font-size: 0.65rem;
    opacity: 0.7;
  }

  .feed__list {
    border-top: 1px solid var(--line-2);
  }
  .feed__row[hidden] {
    display: none;
  }
  .feed__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title thumb'
      'kicker thumb'
      'meta thumb';
    gap: 4px 16px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .feed__link::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .feed__link:hover::before,
  .feed__link:focus-visible::before {
    opacity: 1;
  }
  .feed__index {
    display: none;
    color: var(--muted);
  }
  .feed__title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.75rem);
    line-height: 1;
    text-transform: uppercase;
    transition:
      color 0.25s,
      transform 0.45s var(--ease-out);
  }
  .feed__link:hover .feed__title {
    color: var(--accent);
    transform: translateX(10px);
  }
  .feed__kicker {
    grid-area: kicker;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .feed__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .feed__when {
    color: var(--fg-2);
  }
  .feed__cat {
    color: var(--accent);
  }
  .feed__thumb {
    grid-area: thumb;
    width: 96px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .feed__empty {
    padding: 32px 0;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .feed__link {
      grid-template-columns: 48px minmax(0, 1.4fr) minmax(0, 1fr) 150px 110px;
      grid-template-areas: 'index title kicker when cat';
      gap: 24px;
      padding: 22px 0;
    }
    .feed__index {
      display: block;
      grid-area: index;
    }
    .feed__when {
      grid-area: when;
    }
    .feed__meta {
      display: contents;
    }
    .feed__cat {
      grid-area: cat;
      justify-self: end;
    }
    .feed__thumb {
      display: none;
    }
  }

  .feed__preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    width: 320px;
    aspect-ratio: 16 / 10;
    margin: -100px 0 0 28px;
    pointer-events: none;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line-2);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.7);
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 0.25s,
      scale 0.35s var(--ease-out);
  }
  .feed__preview.is-on {
    opacity: 1;
    scale: 1;
  }
  .feed__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: none), (pointer: coarse), (max-width: 899px) {
    .feed__preview {
      display: none;
    }
  }
</style>
