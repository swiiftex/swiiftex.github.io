---
/**
 * Editor glyphs, drawn on a 16×16 grid to match Unreal's Slate icons.
 * Strokes use currentColor; a few icons carry their own fixed colours
 * (folders, play button) the way they do in the editor.
 */
import type { UeIconName } from '../../lib/editor';

interface Props {
  name: UeIconName;
  size?: number;
  class?: string;
  /** Override the icon's colour (e.g. an asset-type colour). */
  color?: string;
}
const { name, size = 16, class: className, color } = Astro.props;

const S = (d: string) => `<path d="${d}" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>`;
const F = (d: string, fill = 'currentColor') => `<path d="${d}" fill="${fill}"/>`;

