---

<svg
  class:list={['ue-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
  style={color ? `color:${color}` : undefined}
  set:html={ICONS[name]}
/>
