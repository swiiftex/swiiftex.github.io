---
/**
 * Click-to-load YouTube embed. Shows the video thumbnail and only loads the
 * (privacy-enhanced) player after the visitor presses play.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt frame" data-yt={id} data-yt-title={title}>
  <img class="yt__thumb" src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />
  <button class="yt__play" type="button" data-cursor="play" aria-label={`Play video: ${title}`}>
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
      <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3S12.8.3 7.5 1.7a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.5 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3z" fill="currentColor"></path>
      <path d="m27 34 18-10-18-10z" fill="#fff"></path>
    </svg>
  </button>
  <p class="yt__caption mono"><span class="live-dot"></span>{title}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    const btn = box.querySelector('button');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.dataset.ytTitle || 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'yt__frame';
      box.classList.add('is-playing');
      box.append(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    --frame-inset: -6px;
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius);
    overflow: visible;
  }
  .yt__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    filter: brightness(0.75) saturate(0.9);
    transition: filter 0.4s;
  }
  .yt:hover .yt__thumb {
    filter: brightness(0.9) saturate(1);
  }
  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #e3262f;
  }
  .yt__play svg {
    transition: transform 0.4s var(--ease-out);
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 0.5));
  }
  .yt:hover .yt__play svg {
    transform: scale(1.12);
  }
  .yt__caption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.8);
    pointer-events: none;
  }
  .yt.is-playing .yt__thumb,
  .yt.is-playing .yt__play,
  .yt.is-playing .yt__caption {
    display: none;
  }
  .yt :global(.yt__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
  }
</style>
