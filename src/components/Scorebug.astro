---
/**
 * Stats strip styled like a broadcast scorebug. Numeric values count up
 * when scrolled into view; the server-rendered text is the final value.
 */
interface Stat {
  value: number;
  suffix?: string;
  label: string;
  pad?: number;
  href?: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<ul role="list" class="scorebug" data-reveal>
  {
    stats.map((s, i) => {
      const Tag = s.href ? 'a' : 'div';
      return (
        <li class="scorebug__item">
          <Tag class="scorebug__cell" href={s.href} style={`--i:${i}`}>
            <span class="scorebug__label mono">{s.label}</span>
            <span class="scorebug__value">
              <span data-count={s.value} data-pad={s.pad ?? 2}>
                {String(s.value).padStart(s.pad ?? 2, '0')}
              </span>
              {s.suffix && <span class="scorebug__suffix">{s.suffix}</span>}
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .scorebug {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
  }
  @media (min-width: 800px) {
    .scorebug {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .scorebug__item {
    display: contents;
  }
  .scorebug__cell {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 22px 24px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s;
  }
  .scorebug__cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s var(--ease-out);
  }
  a.scorebug__cell:hover {
    background: var(--panel-2);
  }
  a.scorebug__cell:hover::before {
    transform: scaleY(1);
  }
  .scorebug__value {
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 4.75rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .scorebug__suffix {
    color: var(--accent);
    font-size: 0.6em;
  }
  .scorebug__label {
    color: var(--muted);
  }
</style>
