---
import type { IconName } from '../data/site';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;

// Filled brand marks use `fill`; the rest are 1.75px stroke glyphs.
const filled: Partial<Record<IconName, string>> = {
  github:
    'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.62-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3',
  linkedin:
    'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={filled[name] ? 'currentColor' : 'none'}
  stroke={filled[name] ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {filled[name] && <path d={filled[name]} />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'discord' && (
    <>
      <path d="M7.5 7.5c3-1.3 6-1.3 9 0" />
      <path d="M7 16.5c3.3 1.4 6.7 1.4 10 0" />
      <path d="M8.5 5.5 7 5.8C5.2 8.4 4.3 11.4 4.5 15c1.2 1.2 2.6 2 4 2.5l1-1.8M15.5 5.5l1.5.3c1.8 2.6 2.7 5.6 2.5 9.2-1.2 1.2-2.6 2-4 2.5l-1-1.8" />
      <circle cx="9.5" cy="12" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="14.5" cy="12" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'steam' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="15.5" cy="9.5" r="2.5" />
      <circle cx="9" cy="15" r="1.8" />
      <path d="m10.6 14 3-2.3M3.4 13.6l4 1.6" />
    </>
  )}
  {name === 'modio' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
      <path d="M7.5 15.5v-5l2.5 3 2.5-3v5" />
      <circle cx="16" cy="13.5" r="2" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="m10 9.5 4.5 2.5-4.5 2.5z" fill="currentColor" />
    </>
  )}
  {name === 'arrow' && <path class="arrow" d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'download' && <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />}
</svg>
