---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SOCIALS } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '');
  return path === h || path.startsWith(h + '/');
};
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="swiift — home" data-cursor="home">
      <Logo size={30} />
      <span class="brand__word">swiift</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-nav__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-scramble
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__right">
      <a class="btn btn--primary site-header__cta" href="#contact" data-magnetic>Get in touch</a>
      <button class="menu-btn" popovertarget="mobile-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" popover>
  <div class="mobile-menu__top">
    <a class="brand" href="/"><Logo size={28} /><span class="brand__word">swiift</span></a>
    <button class="mobile-menu__close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.75" fill="none" aria-hidden="true">
        <path d="M5 5l14 14M19 5 5 19"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile">
    <ol role="list" class="mobile-menu__list">
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}><span class="mono">00</span>Home</a></li>
      {
        NAV.map((item, i) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <ul role="list" class="mobile-menu__socials">
    {
      SOCIALS.slice(0, 4).map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <Icon name={s.icon} size={20} />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    view-transition-name: site-header;
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .site-header__inner {
    height: 100%;
    width: min(100% - 2 * var(--gutter), 1480px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
  }
  .brand__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: 0.01em;
    line-height: 1;
    transform: translateY(-1px);
  }
  .brand:hover :global(.logo-mark) {
    color: var(--accent);
  }
  .brand :global(.logo-mark) {
    transition: color 0.3s, transform 0.5s var(--ease-out);
  }
  .brand:hover :global(.logo-mark) {
    transform: rotate(-8deg);
  }

  .site-nav {
    margin-left: auto;
    display: none;
  }
  .site-nav ul {
    display: flex;
    gap: 4px;
  }
  .site-nav__link {
    position: relative;
    display: inline-block;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
    transition: color 0.2s;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--fg);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .site-header__cta {
    display: none;
    min-height: 40px;
    padding: 0 16px;
  }

  .menu-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }
  .menu-btn span {
    display: block;
    width: 20px;
    height: 1.75px;
    background: var(--fg);
  }
  .menu-btn span:last-child {
    width: 12px;
    justify-self: end;
  }

  @media (min-width: 900px) {
    .site-nav {
      display: block;
    }
    .site-header__right {
      margin-left: 8px;
    }
    .menu-btn {
      display: none;
    }
    .site-header__cta {
      display: inline-flex;
    }
  }

  /* ---------- mobile menu (native popover) ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 32px;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    flex-direction: column;
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }
  .mobile-menu:popover-open {
    display: flex;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .mobile-menu::backdrop {
    background: transparent;
  }
  .mobile-menu__top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mobile-menu__close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }
  .mobile-menu__list {
    margin-top: 32px;
    display: grid;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 12vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .mobile-menu__list a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu__list .mono {
    color: var(--accent);
    font-size: 0.75rem;
    transform: translateY(-0.6em);
  }
  .mobile-menu__socials {
    margin-top: auto;
    display: flex;
    gap: 12px;
  }
  .mobile-menu__socials a {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }
</style>
