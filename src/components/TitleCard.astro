---
/**
 * Designed stand-in for projects without key art: a broadcast "title card"
 * with the project name set large over the grid.
 */
import Logo from './Logo.astro';

interface Props {
  title: string;
  kicker?: string;
  meta?: string;
  tint?: string;
  class?: string;
}
const { title, kicker, meta, tint, class: className } = Astro.props;
---

<div class:list={['title-card', className]} style={tint ? `--tint:${tint}` : undefined} aria-hidden="true">
  <Logo size="58%" class="title-card__mark" />
  <div class="title-card__text">
    {kicker && <span class="title-card__kicker">{kicker}</span>}
    <span class="title-card__title">{title}</span>
    {meta && <span class="title-card__meta">{meta}</span>}
  </div>
</div>

<style>
  .title-card {
    --tint: var(--accent);
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--tint) 30%, transparent), transparent 60%),
      linear-gradient(to right, color-mix(in oklab, var(--line-2) 70%, transparent) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(to bottom, color-mix(in oklab, var(--line-2) 70%, transparent) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--panel);
  }
  .title-card :global(.title-card__mark) {
    position: absolute;
    right: -12%;
    bottom: -18%;
    color: color-mix(in oklab, var(--tint) 22%, transparent);
    width: 58%;
    height: auto;
  }
  .title-card__text {
    position: absolute;
    inset: auto 7% 9% 7%;
    display: grid;
    gap: 0.6cqi;
  }
  .title-card__kicker,
  .title-card__meta {
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 2.6cqi, 0.85rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tint);
  }
  .title-card__meta {
    color: var(--fg-2);
  }
  .title-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.88;
    font-size: clamp(1.75rem, 10.5cqi, 5.5rem);
    color: var(--fg);
  }
</style>
