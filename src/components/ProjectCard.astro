---
import { Image } from 'astro:assets';
import TitleCard from './TitleCard.astro';
import Icon from './Icon.astro';
import { projectHref, vtName, whenLabel, type Project } from '../lib/projects';
import { CATEGORY_LABELS } from '../data/site';
import type { VideoSource } from '../scripts/hover-video';

/** What plays on hover: a muted trailer, or a slideshow of image URLs. */
export type CardPreview = { kind: 'video'; source: VideoSource } | { kind: 'gallery'; images: string[] };

interface Props {
  project: Project;
  size?: 'feature' | 'default' | 'compact';
  /** Give the cover a view-transition name so it morphs into the project page. */
  morph?: boolean;
  index?: number;
  sizes?: string;
  preview?: CardPreview;
}
const { project, size = 'default', morph = true, index = 0, sizes, preview } = Astro.props;
const { data } = project;
const imgSizes =
  sizes ??
  (size === 'feature'
    ? '(min-width: 900px) 66vw, 100vw'
    : size === 'compact'
      ? '(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw'
      : '(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw');
const meta = [data.studio ?? data.game, whenLabel(project)].filter(Boolean).join(' · ');
---

<article
  class:list={['card', `card--${size}`]}
  data-tilt="4"
  data-reveal
  style={`--i:${index};${data.tint ? `--tint:${data.tint};` : ''}`}
>
  <a href={projectHref(project)} class="card__link" data-cursor="view">
    <div class="card__media frame" style={morph ? `view-transition-name:${vtName(project)}` : undefined}>
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={size === 'feature' ? [640, 960, 1400] : [400, 640, 900]}
            sizes={imgSizes}
            loading={index < 2 ? 'eager' : 'lazy'}
            class="card__img"
          />
        ) : (
          <TitleCard title={data.title} kicker={data.kicker} meta={data.location ?? data.when} tint={data.tint} />
        )
      }
      {preview?.kind === 'video' && <span class="hover-video" data-hover-video={JSON.stringify(preview.source)} data-start="8" aria-hidden="true" />}
      {
        preview?.kind === 'gallery' && (
          <span class="card__slides" data-slides aria-hidden="true">
            {preview.images.map((src) => (
              <img data-src={src} alt="" decoding="async" />
            ))}
          </span>
        )
      }
      <span class="card__chip chip">{CATEGORY_LABELS[data.category]}</span>
    </div>
    <div class="card__body">
      <p class="card__meta mono">{meta}</p>
      <h3 class="card__title display">{data.title}</h3>
      {size !== 'compact' && <p class="card__summary">{data.summary}</p>}
      <span class="card__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
    </div>
  </a>
</article>

<script>
  import { HoverVideo } from '../scripts/hover-video';

  // Hover previews: play a card's trailer, or cycle through its gallery.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canHover && !reduce) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const link = card.querySelector<HTMLElement>('.card__link')!;
      const videoHost = card.querySelector<HTMLElement>('[data-hover-video]');
      const slides = card.querySelector<HTMLElement>('[data-slides]');

      if (videoHost) {
        let player: HoverVideo | null = null;
        link.addEventListener('pointerenter', () => {
          player ??= HoverVideo.fromElement(videoHost);
          player?.play();
        });
        link.addEventListener('pointerleave', () => player?.stop());
      }

      if (slides) {
        const imgs = [...slides.querySelectorAll<HTMLImageElement>('img')];
        let timer = 0;
        let i = 0;
        const show = (n: number) => imgs.forEach((img, k) => img.classList.toggle('is-on', k === n));
        link.addEventListener('pointerenter', () => {
          imgs.forEach((img) => {
            if (!img.src) img.src = img.dataset.src!;
          });
          i = 0;
          show(i);
          slides.classList.add('is-on');
          window.clearInterval(timer);
          timer = window.setInterval(() => show((i = (i + 1) % imgs.length)), 1200);
        });
        link.addEventListener('pointerleave', () => {
          window.clearInterval(timer);
          slides.classList.remove('is-on');
        });
      }
    });
  }
</script>

<style>
  .card {
    --tint: var(--accent);
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    perspective: 900px;
    height: 100%;
  }
  .card__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition:
      transform 0.6s var(--ease-out),
      border-color 0.3s;
  }
  /* Spotlight following the pointer */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in oklab, var(--tint) 16%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card__link:hover,
  .card__link:focus-visible {
    border-color: color-mix(in oklab, var(--tint) 55%, var(--line));
  }
  .card__link:hover::after {
    opacity: 1;
  }

  .card__media {
    --frame-inset: 10px;
    --frame-color: var(--tint);
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
  }
  .card__media::before,
  .card__media::after {
    opacity: 0;
  }
  .card__link:hover .card__media::before,
  .card__link:hover .card__media::after,
  .card__link:focus-visible .card__media::before,
  .card__link:focus-visible .card__media::after {
    opacity: 1;
    --frame-inset: 14px;
  }
  .card__media :global(.card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.6s;
    filter: saturate(0.9) brightness(0.92);
  }
  .card__link:hover :global(.card__img) {
    transform: scale(1.045);
    filter: saturate(1.05) brightness(1);
  }
  /* Gallery slideshow shown over the cover while hovered */
  .card__slides {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .card__slides.is-on {
    opacity: 1;
  }
  .card__slides img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .card__slides img.is-on {
    opacity: 1;
  }
  .card__chip {
    position: absolute;
    top: 12px;
    right: 12px;
    background: color-mix(in oklab, var(--bg) 75%, transparent);
    backdrop-filter: blur(6px);
    z-index: 2;
  }

  .card__body {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 20px 22px 24px;
    flex: 1;
    align-content: start;
  }
  .card__meta {
    color: var(--tint);
    font-size: 0.6875rem;
    padding-right: 32px;
  }
  .card__title {
    font-size: clamp(1.75rem, 2.6vw, 2.4rem);
    font-weight: 700;
    line-height: 0.95;
  }
  .card--feature .card__title {
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
  }
  .card--compact .card__title {
    font-size: 1.6rem;
  }
  .card__summary {
    color: var(--fg-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .card__go {
    position: absolute;
    top: 16px;
    right: 18px;
    color: var(--muted);
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s;
  }
  .card__link:hover .card__go {
    color: var(--tint);
    transform: translateX(4px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .card--feature .card__media {
      aspect-ratio: 16 / 8;
    }
  }
</style>
