---
/**
 * Image grid with a keyboard-friendly lightbox built on <dialog>.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string }[];
}
const { items } = Astro.props;
const large = await Promise.all(items.map((i) => getImage({ src: i.src, width: Math.min(i.src.width, 1920), format: 'webp' })));
---

{
  items.length > 0 && (
    <div class="gallery" data-gallery>
      <ul role="list" class="gallery__grid">
        {items.map((item, i) => (
          <li data-reveal style={`--i:${i % 4}`}>
            <button
              type="button"
              class="gallery__item frame"
              data-cursor="zoom"
              data-full={large[i].src}
              data-alt={item.alt}
              aria-label={`View larger: ${item.alt}`}
            >
              <Image src={item.src} alt={item.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 33vw, (min-width: 560px) 50vw, 100vw" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
      <dialog class="lightbox" aria-label="Image viewer">
        <figure class="lightbox__figure">
          <img class="lightbox__img" alt="" />
          <figcaption class="lightbox__caption mono" />
        </figure>
        <div class="lightbox__bar">
          <button type="button" class="lightbox__btn" data-prev aria-label="Previous image">←</button>
          <span class="lightbox__count mono" />
          <button type="button" class="lightbox__btn" data-next aria-label="Next image">→</button>
          <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Close">✕</button>
        </div>
      </dialog>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('.gallery__item')];
    const dialog = root.querySelector('dialog')!;
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      img.src = it.dataset.full!;
      img.alt = it.dataset.alt || '';
      caption.textContent = it.dataset.alt || '';
      count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
    };
    items.forEach((it, i) =>
      it.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>

<style>
  .gallery__grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .gallery__item {
    --frame-inset: 8px;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .gallery__item::before,
  .gallery__item::after {
    opacity: 0;
  }
  .gallery__item:hover::before,
  .gallery__item:hover::after {
    opacity: 1;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .gallery__item:hover :global(img) {
    transform: scale(1.05);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgb(5 6 9 / 0.94);
    color: var(--fg);
    flex-direction: column;
    gap: 16px;
  }
  .lightbox[open] {
    display: flex;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__figure {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 12px;
    place-items: center;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .lightbox__caption {
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .lightbox__btn {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    font-size: 1.1rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .lightbox__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lightbox__close {
    margin-left: 12px;
  }
</style>
