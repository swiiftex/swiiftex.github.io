---
/**
 * The swiift mark — a sword through a split shield — redrawn as SVG so it
 * can be tinted, scaled and animated.
 */
interface Props {
  size?: number | string;
  class?: string;
  /** Animate the strokes drawing in on load. */
  draw?: boolean;
  /**
   * Intro on load: the logo fades in with a whole shield, then the sword drops
   * in and pierces it — breaking through the top and bottom with a burst of
   * shards — bounces, and the shield shakes.
   */
  intro?: boolean;
  /** Crop the empty space either side of the shield (taller, narrower box). */
  tight?: boolean;
}
const { size = 32, class: className, draw = false, intro = false, tight = false } = Astro.props;
---

<svg
  class:list={['logo-mark', { 'logo-mark--draw': draw, 'logo-mark--intro': intro }, className]}
  width={size}
  height={tight ? undefined : size}
  viewBox={tight ? '18 0 64 100' : '0 0 100 100'}
  role="img"
  aria-label="swiift logo"
>
  <g class="logo-mark__shield" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round">
    <path d="M46.5 37.5C40 39.5 33 42.2 25.2 41.8c-.2 12.3 1.3 22.9 5 31L47.4 87" />
    <path d="M53.5 37.5C60 39.5 67 42.2 74.8 41.8c.2 12.3-1.3 22.9-5 31L52.6 87" />
    {
      intro && (
        // Fills the slot so the shield starts whole; broken away by the sword.
        <g class="logo-mark__seal">
          <path data-seal="top-l" d="M46.5 37.5Q48.3 36.9 50 36.75" />
          <path data-seal="top-r" d="M50 36.75Q51.7 36.9 53.5 37.5" />
          <path data-seal="bot-l" d="M47.4 87L50 89.15" />
          <path data-seal="bot-r" d="M52.6 87L50 89.15" />
        </g>
      )
    }
  </g>
  <g class="logo-mark__sword">
    <path class="logo-mark__guard" d="M36.2 28.8Q50 25.8 63.8 28.8" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
    <g fill="currentColor">
      <circle cx="50" cy="9.6" r="3.9" />
      <path d="M48.5 12.5h3l-.4 14.5h-2.2z" />
      <path d="M48.2 30h3.6l-1 57.5L50 92l-.8-4.5z" />
    </g>
  </g>
  {intro && <g class="logo-mark__fx" />}
</svg>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const BLADE_TIP = 92; // y of the blade tip at rest, in the logo's 100×100 grid
  const SEAL_TOP = 36.8;
  const SEAL_BOTTOM = 89.1;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Opened in a background tab? Hold the intro until the page is actually seen.
  const whenVisible = (fn: () => void) => {
    if (!document.hidden) return fn();
    const onShow = () => {
      if (document.hidden) return;
      document.removeEventListener('visibilitychange', onShow);
      fn();
    };
    document.addEventListener('visibilitychange', onShow);
  };

  // The intro plays once per visit (the page head marks the root `logo-played`
  // afterwards); hovering a [data-logo-replay] host plays it again.
  const PLAYED = 'swiift:logo-played';
  const running = new WeakSet<SVGSVGElement>();

  async function play(svg: SVGSVGElement) {
    if (running.has(svg)) return;
    running.add(svg);
    svg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    svg.classList.add('is-playing');
    // intro() sets up its (backwards-filling) animations synchronously, so the
    // CSS that hides the logo before its first play can be dropped straight away.
    const done = intro(svg);
    document.documentElement.classList.add('logo-played');
    await done;
    svg.classList.remove('is-playing');
    svg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    running.delete(svg);
  }

  document.querySelectorAll<SVGSVGElement>('.logo-mark--intro').forEach((svg) => {
    if (!document.documentElement.classList.contains('logo-played'))
      whenVisible(() => {
        play(svg);
        try {
          sessionStorage.setItem(PLAYED, '1');
        } catch {
          /* private mode */
        }
      });
    svg.closest('[data-logo-replay]')?.addEventListener('pointerenter', () => {
      if (!reduce) play(svg);
    });
  });

  function intro(svg: SVGSVGElement): Promise<void> {
    const shield = svg.querySelector<SVGGElement>('.logo-mark__shield')!;
    const sword = svg.querySelector<SVGGElement>('.logo-mark__sword')!;
    const fx = svg.querySelector<SVGGElement>('.logo-mark__fx')!;
    const seal = (k: string) => svg.querySelector<SVGPathElement>(`[data-seal="${k}"]`)!;
    if (reduce || !sword.animate) return Promise.resolve();

    // 1. The whole logo fades in (shield whole, sword still hidden).
    shield.animate(
      [
        { opacity: 0, transform: 'scale(0.94)' },
        { opacity: 1, transform: 'none' },
      ],
      { duration: 300, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'both' },
    );

    // 2. The sword fades in above, accelerates down through the shield, overshoots and bounces.
    const swordAnim = sword.animate(
      [
        { opacity: 0, transform: 'translateY(-74px)', easing: 'cubic-bezier(.2,.7,.4,1)' },
        { opacity: 1, transform: 'translateY(-64px)', offset: 0.26, easing: 'cubic-bezier(.6,0,1,.5)' },
        { transform: 'translateY(3.5px)', offset: 0.6, easing: 'cubic-bezier(.3,.6,.4,1)' },
        { transform: 'translateY(-2.5px)', offset: 0.8, easing: 'ease-in-out' },
        { opacity: 1, transform: 'none' },
      ],
      { duration: 460, delay: 300, fill: 'both' },
    );

    // 3. Break the shield where the blade tip actually crosses it.
    const shake = () =>
      shield.animate(
        [
          { transform: 'none' },
          { transform: 'translateX(-2.2px) rotate(-3.5deg)' },
          { transform: 'translateX(1.8px) rotate(2.6deg)' },
          { transform: 'translateX(-1.1px) rotate(-1.4deg)' },
          { transform: 'translateX(0.5px) rotate(0.6deg)' },
          { transform: 'none' },
        ],
        { duration: 260, easing: 'ease-out' },
      );

    const burst = (y: number, dir: 1 | -1) => {
      // A quick flash ring where the blade breaks through…
      const flash = document.createElementNS(SVG_NS, 'circle');
      flash.setAttribute('cx', '50');
      flash.setAttribute('cy', String(y));
      flash.setAttribute('r', '2');
      flash.setAttribute('class', 'logo-mark__flash');
      fx.append(flash);
      flash
        .animate(
          [
            { opacity: 0.9, transform: 'scale(0.6)' },
            { opacity: 0, transform: 'scale(3.4)' },
          ],
          { duration: 300, easing: 'cubic-bezier(.2,.8,.3,1)', fill: 'forwards' },
        )
        .finished.then(() => flash.remove());

      // …and shards thrown out the way the blade is travelling.
      for (let i = 0; i < 9; i++) {
        const angle = ((dir * 90 + (Math.random() * 150 - 75)) * Math.PI) / 180;
        const len = 1.4 + Math.random() * 2.6;
        const dist = 7 + Math.random() * 13;
        const shard = document.createElementNS(SVG_NS, 'line');
        shard.setAttribute('x1', '50');
        shard.setAttribute('y1', String(y));
        shard.setAttribute('x2', String(50 + Math.cos(angle) * len));
        shard.setAttribute('y2', String(y + Math.sin(angle) * len));
        shard.setAttribute('class', i % 3 === 0 ? 'logo-mark__shard logo-mark__shard--accent' : 'logo-mark__shard');
        fx.append(shard);
        shard
          .animate(
            [
              { opacity: 1, transform: 'none' },
              {
                opacity: 0,
                transform: `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist}px) rotate(${Math.random() * 160 - 80}deg)`,
              },
            ],
            { duration: 320 + Math.random() * 200, easing: 'cubic-bezier(.15,.8,.3,1)', fill: 'forwards' },
          )
          .finished.then(() => shard.remove());
      }
    };

    const breakSeal = (left: SVGPathElement, right: SVGPathElement, dir: 1 | -1) => {
      const opts: KeyframeAnimationOptions = { duration: 280, easing: 'cubic-bezier(.2,.8,.3,1)', fill: 'forwards' };
      left.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translate(-3.5px, ${dir * 3}px) rotate(${-30 * dir}deg)` }], opts);
      right.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translate(3.5px, ${dir * 3}px) rotate(${30 * dir}deg)` }], opts);
    };

    let top = false;
    let bottom = false;
    const pierceTop = () => {
      top = true;
      breakSeal(seal('top-l'), seal('top-r'), -1);
      burst(SEAL_TOP, -1);
      shake();
    };
    const pierceBottom = () => {
      bottom = true;
      breakSeal(seal('bot-l'), seal('bot-r'), 1);
      burst(SEAL_BOTTOM, 1);
    };

    const watch = () => {
      const m = getComputedStyle(sword).transform;
      const ty = m === 'none' ? 0 : Number(m.slice(m.indexOf('(') + 1, -1).split(',')[5]);
      const tip = BLADE_TIP + ty;
      if (!top && tip >= SEAL_TOP) pierceTop();
      if (!bottom && tip >= SEAL_BOTTOM) pierceBottom();
      if (!(top && bottom) && swordAnim.playState === 'running') requestAnimationFrame(watch);
    };
    requestAnimationFrame(watch);
    // Safety net: if frames were skipped (e.g. a background tab), still finish the break.
    return swordAnim.finished.then(() => {
      if (!top) pierceTop();
      if (!bottom) pierceBottom();
      return new Promise<void>((done) => setTimeout(done, 520));
    });
  }
</script>

<style>
  .logo-mark {
    flex: none;
    overflow: visible;
  }

  /* ---------- draw-on (strokes trace in, sword drops) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .logo-mark--draw .logo-mark__shield,
    .logo-mark--draw .logo-mark__guard {
      stroke-dasharray: 120;
      stroke-dashoffset: 120;
      animation: logo-draw 1.4s var(--ease-out) 0.2s forwards;
    }
    .logo-mark--draw .logo-mark__guard {
      animation-delay: 0.6s;
    }
    .logo-mark--draw .logo-mark__sword {
      transform: translateY(-14px);
      opacity: 0;
      animation: logo-sword 0.9s var(--ease-out) 0.05s forwards;
    }
  }
  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes logo-sword {
    to {
      transform: none;
      opacity: 1;
    }
  }

  /* ---------- intro (driven by the script above) ---------- */
  .logo-mark__seal {
    display: none; /* without the animation, show the finished, pierced logo */
  }
  .logo-mark__shield {
    transform-box: fill-box;
    transform-origin: 50% 35%;
  }
  .logo-mark__seal path,
  .logo-mark__fx :global(line) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .logo-mark__fx :global(.logo-mark__flash) {
    transform-box: fill-box;
    transform-origin: center;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.9;
  }
  .logo-mark__fx :global(.logo-mark__shard) {
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .logo-mark__fx :global(.logo-mark__shard--accent) {
    stroke: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Hidden until the script fades them in, so there's no flash of the finished logo. */
    :global(.js:not(.logo-played)) .logo-mark--intro .logo-mark__shield,
    :global(.js:not(.logo-played)) .logo-mark--intro .logo-mark__sword {
      opacity: 0;
      animation: logo-failsafe 0s 2.5s forwards; /* if the script never runs, show it anyway */
    }
    :global(.js:not(.logo-played)) .logo-mark--intro .logo-mark__seal,
    .logo-mark--intro.is-playing .logo-mark__seal {
      display: inline;
    }
  }
  @keyframes logo-failsafe {
    to {
      opacity: 1;
    }
  }
</style>
