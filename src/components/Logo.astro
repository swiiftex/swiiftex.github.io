---
/**
 * The swiift mark — a sword through a split shield — redrawn as SVG so it
 * can be tinted, scaled and "drawn on" with a stroke animation.
 */
interface Props {
  size?: number | string;
  class?: string;
  /** Animate the strokes drawing in on load. */
  draw?: boolean;
}
const { size = 32, class: className, draw = false } = Astro.props;
---

<svg
  class:list={['logo-mark', { 'logo-mark--draw': draw }, className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-label="swiift logo"
>
  <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round">
    <path class="logo-mark__shield" d="M46.5 37.5C40 39.5 33 42.2 25.2 41.8c-.2 12.3 1.3 22.9 5 31L47.4 87" />
    <path class="logo-mark__shield" d="M53.5 37.5C60 39.5 67 42.2 74.8 41.8c.2 12.3-1.3 22.9-5 31L52.6 87" />
    <path class="logo-mark__guard" d="M36.2 28.8Q50 25.8 63.8 28.8" />
  </g>
  <g fill="currentColor" class="logo-mark__sword">
    <circle cx="50" cy="9.6" r="3.9" />
    <path d="M48.5 12.5h3l-.4 14.5h-2.2z" />
    <path d="M48.2 30h3.6l-1 57.5L50 92l-.8-4.5z" />
  </g>
</svg>

<style>
  .logo-mark {
    flex: none;
    overflow: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-mark--draw .logo-mark__shield,
    .logo-mark--draw .logo-mark__guard {
      stroke-dasharray: 120;
      stroke-dashoffset: 120;
      animation: logo-draw 1.4s var(--ease-out) 0.2s forwards;
    }
    .logo-mark--draw .logo-mark__guard {
      animation-delay: 0.6s;
    }
    .logo-mark--draw .logo-mark__sword {
      transform-origin: 50% 0;
      transform: translateY(-14px);
      opacity: 0;
      animation: logo-sword 0.9s var(--ease-out) 0.05s forwards;
    }
  }
  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes logo-sword {
    to {
      transform: none;
      opacity: 1;
    }
  }
</style>
