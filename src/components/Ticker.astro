---
/** Broadcast-style news ticker. Content is duplicated for a seamless loop. */
interface Props {
  label?: string;
  items: { text: string; href?: string }[];
}
const { label = 'Latest', items } = Astro.props;
---

<div class="ticker" role="region" aria-label="Latest news">
  <div class="ticker__label mono"><span class="live-dot"></span>{label}</div>
  <div class="ticker__viewport">
    {
      [0, 1].map((copy) => (
        <ul role="list" class="ticker__track" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li class="ticker__item">
              {item.href ? (
                <a href={item.href} tabindex={copy === 1 ? -1 : undefined}>
                  {item.text}
                </a>
              ) : (
                <span>{item.text}</span>
              )}
              <span class="ticker__sep" aria-hidden="true">
                ✦
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    display: flex;
    align-items: stretch;
    height: 48px;
    border-block: 1px solid var(--line);
    background: color-mix(in oklab, var(--bg-2) 85%, transparent);
    overflow: hidden;
  }
  .ticker__label {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
    padding-right: 30px;
    position: relative;
    z-index: 1;
  }
  .ticker__label .live-dot {
    background: var(--accent-ink);
    animation: none;
  }
  .ticker__viewport {
    flex: 1;
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  .ticker__track {
    flex: none;
    display: flex;
    align-items: center;
    animation: ticker 50s linear infinite;
  }
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }
  .ticker__item {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--fg-2);
  }
  .ticker__item a:hover {
    color: var(--accent);
  }
  .ticker__sep {
    margin: 0 24px;
    color: var(--accent);
    font-size: 0.75rem;
  }
  @keyframes ticker {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__viewport {
      overflow-x: auto;
    }
    .ticker__track {
      animation: none;
    }
    .ticker__track[aria-hidden] {
      display: none;
    }
  }
</style>
