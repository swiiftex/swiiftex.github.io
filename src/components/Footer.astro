---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, SOCIALS, NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="cta">
      <p class="eyebrow">Contact</p>
      <h2 class="display cta__title">Get in touch</h2>
      <p class="lede">
        I'm always looking for new projects and people to work with. If you have something in mind, get in touch.
      </p>

      <button class="email" type="button" data-copy={SITE.email} data-cursor="copy" data-magnetic>
        <Icon name="mail" size={22} />
        <span class="email__text">{SITE.email}</span>
        <span class="email__hint mono">Click to copy</span>
      </button>
      <a class="mailto mono" href={`mailto:${SITE.email}`}>Or open in your mail app →</a>
    </div>

    <div class="footer-grid">
      <div class="footer-col">
        <p class="mono muted">Elsewhere</p>
        <ul role="list" class="socials">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="social">
                  <Icon name={s.icon} size={18} />
                  <span class="social__label">{s.label}</span>
                  <span class="social__handle mono">{s.handle}</span>
                  <Icon name="external" size={14} class="social__ext" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer-col">
        <p class="mono muted">Pages</p>
        <ul role="list" class="footer-links">
          <li><a href="/">Home</a></li>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/melee-slashers/">Melee slashers guide</a></li>
        </ul>
      </div>
      <div class="footer-col footer-col--status">
        <p class="mono muted">Local time</p>
        <p class="clock"><span data-clock>--:--</span> <span class="mono muted">{SITE.location}</span></p>
        <p class="mono muted" style="margin-top:24px">Time on site</p>
        <p class="clock clock--tc"><span data-timecode>00:00:00:00</span></p>
      </div>
    </div>

    <div class="footer-base">
      <a href="/" class="footer-base__brand" aria-label="swiift — home"><Logo size={22} /> swiift</a>
      <p class="mono muted">© {year} {SITE.author}</p>
      <p class="mono muted">Built with Astro · Hosted on GitHub Pages</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(40px, 8vw, 120px);
    padding-top: clamp(64px, 10vw, 140px);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(50rem 24rem at 15% 0%, color-mix(in oklab, var(--accent) 9%, transparent), transparent 70%),
      var(--bg-2);
  }
  .cta {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .cta__title {
    font-size: clamp(3rem, 9vw, 7rem);
  }
  .email {
    margin-top: 16px;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 16px;
    padding: 20px 26px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--panel);
    text-align: left;
    max-width: 100%;
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }
  .email:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .email__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 5vw, 2.75rem);
    line-height: 1;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .email__hint {
    color: var(--accent);
  }
  .mailto {
    color: var(--muted);
    transition: color 0.2s;
  }
  .mailto:hover {
    color: var(--accent);
  }

  .footer-grid {
    margin-top: clamp(64px, 9vw, 120px);
    display: grid;
    gap: 40px;
    padding-bottom: 48px;
  }
  @media (min-width: 800px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .footer-col > .mono:first-child {
    margin-bottom: 14px;
  }
  .socials {
    display: grid;
  }
  .social {
    display: grid;
    grid-template-columns: 20px auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    transition: color 0.2s, padding 0.35s var(--ease-out);
  }
  .social:hover {
    color: var(--fg);
    padding-left: 8px;
  }
  .social__label {
    font-weight: 600;
  }
  .social__handle {
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .social :global(.social__ext) {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: 0.3s var(--ease-out);
    color: var(--accent);
  }
  .social:hover :global(.social__ext) {
    opacity: 1;
    transform: none;
  }
  .footer-links {
    display: grid;
    gap: 8px;
  }
  .footer-links a {
    color: var(--fg-2);
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
  .clock {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }
  .clock--tc {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--fg-2);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
  }
  .footer-base__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }
</style>
