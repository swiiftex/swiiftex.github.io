---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TitleCard from '../components/TitleCard.astro';
import { getProjects, projectHref, vtName } from '../lib/projects';

const events = await getProjects('events');
---

<Base title="Events" description="Live VR esports broadcasts produced by Owen Bladen-Kay — Duckman LAN 2022 and 2023, VRLAN 2024 and VRLAN 2026.">
  <PageHeader
    index="03"
    eyebrow="Portfolio"
    title="Events"
    lede="I produced broadcasts for in-person VR esports events from 2022 to 2026, most recently as Production Lead at VRLAN."
  />

  <section class="container section--tight" aria-labelledby="ros-title">
    <div class="ros__head">
      <h2 id="ros-title" class="eyebrow"><span class="eyebrow__index">{String(events.length).padStart(2, '0')}</span><span class="eyebrow__rule"></span>Past events</h2>
      <p class="mono muted ros__cols" aria-hidden="true"><span>#</span><span>Date / venue</span><span>Event</span></p>
    </div>
    <ol role="list" class="ros">
      {
        events.map((e, i) => (
          <li class="ros__item" data-reveal style={`--i:${i};${e.data.tint ? `--tint:${e.data.tint}` : ''}`}>
            <a href={projectHref(e)} class="ros__row" data-cursor="view">
              <span class="ros__seg mono">{String(events.length - i).padStart(2, '0')}</span>
              <span class="ros__when">
                <span class="ros__date">{e.data.when}</span>
                <span class="mono muted">{e.data.location}</span>
              </span>
              <span class="ros__main">
                <span class="ros__kicker mono">{e.data.kicker}</span>
                <span class="ros__title display">{e.data.title}</span>
                <span class="ros__summary">{e.data.summary}</span>
                {e.data.role && <span class="chip chip--accent ros__role">{e.data.role}</span>}
              </span>
              <span class="ros__media frame" style={`view-transition-name:${vtName(e)}`}>
                {e.data.cover ? (
                  <Image src={e.data.cover} alt={e.data.coverAlt ?? ''} widths={[400, 700, 1000]} sizes="(min-width: 1000px) 380px, 100vw" loading={i < 2 ? 'eager' : 'lazy'} />
                ) : (
                  <TitleCard title={e.data.title} meta={e.data.location} tint={e.data.tint} />
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  /* ---------- event list ---------- */
  .ros__head {
    display: grid;
    gap: 16px;
    margin-bottom: 8px;
  }
  .ros__cols {
    display: none;
  }
  @media (min-width: 1000px) {
    .ros__cols {
      display: grid;
      grid-template-columns: 90px 200px 1fr;
      gap: 32px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line-2);
    }
  }
  .ros__item {
    --tint: var(--accent);
  }
  .ros__row {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .ros__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in oklab, var(--tint) 10%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .ros__row:hover::before {
    opacity: 1;
  }
  @media (min-width: 1000px) {
    .ros__row {
      grid-template-columns: 90px 200px 1fr 380px;
      gap: 32px;
      align-items: start;
      padding: 36px 0;
    }
  }
  .ros__seg {
    color: var(--tint);
    padding-top: 6px;
  }
  .ros__when {
    display: grid;
    gap: 6px;
  }
  .ros__date {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .ros__main {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .ros__kicker {
    color: var(--tint);
  }
  .ros__title {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    transition: color 0.25s;
  }
  .ros__row:hover .ros__title {
    color: var(--tint);
  }
  .ros__summary {
    color: var(--fg-2);
    max-width: 52ch;
  }
  .ros__role {
    margin-top: 4px;
    border-color: color-mix(in oklab, var(--tint) 50%, transparent);
    color: var(--tint);
    background: color-mix(in oklab, var(--tint) 12%, transparent);
  }
  .ros__media {
    --frame-inset: 10px;
    --frame-color: var(--tint);
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .ros__media::before,
  .ros__media::after {
    opacity: 0;
  }
  .ros__row:hover .ros__media::before,
  .ros__row:hover .ros__media::after {
    opacity: 1;
  }
  .ros__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .ros__row:hover .ros__media :global(img) {
    transform: scale(1.05);
  }
</style>
