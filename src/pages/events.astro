---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TitleCard from '../components/TitleCard.astro';
import Icon from '../components/Icon.astro';
import { getProjects, projectHref, vtName } from '../lib/projects';
import { NEXT_EVENT } from '../data/site';

const events = await getProjects('events');
---

<Base title="Events" description="Live VR esports broadcasts produced by Owen Bladen-Kay — Duckman LAN 2022 and 2023, VRLAN 2024 and VRLAN 2026.">
  <PageHeader
    index="03"
    eyebrow="Portfolio"
    title="Events"
    lede="I've produced broadcasts for in-person VR esports events since 2022. I'm currently Production Lead and a company director at VRLAN."
  />

  <!-- Up next -->
  <section class="container" aria-labelledby="next-title">
    <div class="next panel" data-reveal data-countdown={NEXT_EVENT.startsAt}>
      <div class="next__label mono">Next event</div>
      <div class="next__main">
        <h2 id="next-title" class="display next__title">{NEXT_EVENT.title}</h2>
        <p class="mono muted">{NEXT_EVENT.dates} · {NEXT_EVENT.where}</p>
      </div>
      <dl class="next__clock" aria-label="Countdown">
        <div><dt class="mono">Days</dt><dd data-cd="d">---</dd></div>
        <div><dt class="mono">Hrs</dt><dd data-cd="h">--</dd></div>
        <div><dt class="mono">Min</dt><dd data-cd="m">--</dd></div>
        <div><dt class="mono">Sec</dt><dd data-cd="s">--</dd></div>
      </dl>
      <a class="btn btn--primary next__cta" href={NEXT_EVENT.href} target="_blank" rel="noopener" data-magnetic>
        vr-lan.com <Icon name="external" />
      </a>
    </div>
  </section>

  <!-- Run of show -->
  <section class="section container" aria-labelledby="ros-title">
    <div class="ros__head">
      <h2 id="ros-title" class="eyebrow"><span class="eyebrow__index">{String(events.length).padStart(2, '0')}</span><span class="eyebrow__rule"></span>Past events</h2>
      <p class="mono muted ros__cols" aria-hidden="true"><span>#</span><span>Date / venue</span><span>Event</span></p>
    </div>
    <ol role="list" class="ros">
      {
        events.map((e, i) => (
          <li class="ros__item" data-reveal style={`--i:${i};${e.data.tint ? `--tint:${e.data.tint}` : ''}`}>
            <a href={projectHref(e)} class="ros__row" data-cursor="view">
              <span class="ros__seg mono">{String(events.length - i).padStart(2, '0')}</span>
              <span class="ros__when">
                <span class="ros__date">{e.data.when}</span>
                <span class="mono muted">{e.data.location}</span>
              </span>
              <span class="ros__main">
                <span class="ros__kicker mono">{e.data.kicker}</span>
                <span class="ros__title display">{e.data.title}</span>
                <span class="ros__summary">{e.data.summary}</span>
                {e.data.role && <span class="chip chip--accent ros__role">{e.data.role}</span>}
              </span>
              <span class="ros__media frame" style={`view-transition-name:${vtName(e)}`}>
                {e.data.cover ? (
                  <Image src={e.data.cover} alt={e.data.coverAlt ?? ''} widths={[400, 700, 1000]} sizes="(min-width: 1000px) 380px, 100vw" loading={i < 2 ? 'eager' : 'lazy'} />
                ) : (
                  <TitleCard title={e.data.title} meta={e.data.location} tint={e.data.tint} />
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const target = new Date(el.dataset.countdown!).getTime();
    const out = (k: string) => el.querySelector<HTMLElement>(`[data-cd="${k}"]`)!;
    const [d, h, m, s] = ['d', 'h', 'm', 's'].map(out);
    const two = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const left = Math.max(target - Date.now(), 0);
      const sec = Math.floor(left / 1000);
      d.textContent = String(Math.floor(sec / 86400)).padStart(3, '0');
      h.textContent = two(Math.floor(sec / 3600) % 24);
      m.textContent = two(Math.floor(sec / 60) % 60);
      s.textContent = two(sec % 60);
    };
    tick();
    setInterval(tick, 1000);
  });
</script>

<style>
  /* ---------- up next ---------- */
  .next {
    display: grid;
    gap: 20px 32px;
    align-items: center;
    padding: clamp(20px, 3vw, 32px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--line));
    background:
      radial-gradient(70% 140% at 0% 50%, var(--accent-soft), transparent 70%),
      linear-gradient(180deg, var(--panel-2), var(--panel));
  }
  @media (min-width: 1000px) {
    .next {
      grid-template-columns: auto 1fr auto auto;
    }
  }
  .next__label {
    color: var(--accent);
    font-weight: 700;
  }
  .next__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .next__clock {
    display: flex;
    gap: 6px;
  }
  .next__clock div {
    display: grid;
    justify-items: center;
    gap: 4px;
    min-width: 64px;
    padding: 10px 8px;
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 4px;
  }
  .next__clock dt {
    order: 2;
    color: var(--muted);
    font-size: 0.6rem;
  }
  .next__clock dd {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .next__cta {
    justify-self: start;
  }

  /* ---------- run of show ---------- */
  .ros__head {
    display: grid;
    gap: 16px;
    margin-bottom: 8px;
  }
  .ros__cols {
    display: none;
  }
  @media (min-width: 1000px) {
    .ros__cols {
      display: grid;
      grid-template-columns: 90px 200px 1fr;
      gap: 32px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line-2);
    }
  }
  .ros__item {
    --tint: var(--accent);
  }
  .ros__row {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .ros__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in oklab, var(--tint) 10%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .ros__row:hover::before {
    opacity: 1;
  }
  @media (min-width: 1000px) {
    .ros__row {
      grid-template-columns: 90px 200px 1fr 380px;
      gap: 32px;
      align-items: start;
      padding: 36px 0;
    }
  }
  .ros__seg {
    color: var(--tint);
    padding-top: 6px;
  }
  .ros__when {
    display: grid;
    gap: 6px;
  }
  .ros__date {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .ros__main {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .ros__kicker {
    color: var(--tint);
  }
  .ros__title {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    transition: color 0.25s;
  }
  .ros__row:hover .ros__title {
    color: var(--tint);
  }
  .ros__summary {
    color: var(--fg-2);
    max-width: 52ch;
  }
  .ros__role {
    margin-top: 4px;
    border-color: color-mix(in oklab, var(--tint) 50%, transparent);
    color: var(--tint);
    background: color-mix(in oklab, var(--tint) 12%, transparent);
  }
  .ros__media {
    --frame-inset: 10px;
    --frame-color: var(--tint);
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .ros__media::before,
  .ros__media::after {
    opacity: 0;
  }
  .ros__row:hover .ros__media::before,
  .ros__row:hover .ros__media::after {
    opacity: 1;
  }
  .ros__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .ros__row:hover .ros__media :global(img) {
    transform: scale(1.05);
  }
</style>
