---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { getProjects } from '../lib/projects';
import { cardPreview } from '../lib/previews';
import { MODIO } from '../data/site';
import modioLogo from '../assets/brand/modio.png';

const games = await getProjects('games');
const mods = await getProjects('mods');
const gamePreviews = await Promise.all(games.map(cardPreview));
const modPreviews = await Promise.all(mods.map(cardPreview));
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10_000 ? 0 : 1)}K` : String(n));
---

<Base title="Games & Mods" description="Games I've worked on and built — Directive 8020, Night Crew, LUNARBALL and VENATOR — plus MORDHAU mods with 130K+ downloads on mod.io.">
  <PageHeader
    index="01"
    eyebrow="Portfolio"
    title="Games & mods"
    lede="Games I've worked on or made myself, and mods for MORDHAU and Hellsplit Arena."
  />
  <link slot="head" rel="preconnect" href="https://video.akamai.steamstatic.com" crossorigin />

  <section class="container section--tight" aria-labelledby="games-title">
    <h2 id="games-title" class="eyebrow"><span class="eyebrow__index">{String(games.length).padStart(2, '0')}</span><span class="eyebrow__rule"></span>Games</h2>
    <ul role="list" class="grid grid--games">
      {
        games.map((p, i) => (
          <li class:list={[i === 0 && 'grid__wide']}>
            <ProjectCard project={p} size={i === 0 ? 'feature' : 'default'} index={i} preview={gamePreviews[i]} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" id="mods" aria-labelledby="mods-title">
    <div class="mods-banner panel" data-reveal>
      <div class="mods-banner__copy">
        <p class="eyebrow"><span class="eyebrow__index">{String(mods.length).padStart(2, '0')}</span><span class="eyebrow__rule"></span>Mods</p>
        <h2 id="mods-title" class="display h2">Mods</h2>
        <p class="lede">Game modes, competitive changes, scoreboards and map packs, mostly for MORDHAU.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={MODIO.profile} target="_blank" rel="noopener" data-magnetic>
            All my mods on mod.io <Icon name="external" />
          </a>
        </div>
      </div>
      <a class="mods-banner__stat" href={MODIO.profile} target="_blank" rel="noopener" data-cursor="open">
        <Image src={modioLogo} alt="mod.io" width={160} class="mods-banner__logo" />
        <span class="mods-banner__num display"><span data-count="130" data-pad="0">130</span><span class="accent">K+</span></span>
        <span class="mono muted">downloads across {14} mods</span>
      </a>
    </div>

    <ul role="list" class="grid grid--mods">
      {
        mods.map((p, i) => (
          <li class="mod">
            <ProjectCard project={p} size="compact" index={i % 4} preview={modPreviews[i]} />
            {p.data.downloads && <span class="mod__dl mono">↓ {fmt(p.data.downloads)}</span>}
          </li>
        ))
      }
    </ul>

    <div class="more" data-reveal>
      <p class="mono muted">Also on mod.io</p>
      <ul role="list" class="more__list">
        {
          MODIO.more.map((m) => (
            <li>
              <a href={m.href} target="_blank" rel="noopener">
                <span>{m.title}</span>
                <span class="mono muted">↓ {fmt(m.downloads)}</span>
                <Icon name="external" size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: 20px;
    margin-top: 24px;
  }
  @media (min-width: 700px) {
    .grid--games {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid__wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .grid--games {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid__wide {
      grid-column: span 3;
    }
  }
  .grid--mods {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    margin-top: 32px;
  }
  .mod {
    position: relative;
  }
  .mod__dl {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 9px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 75%, transparent);
    backdrop-filter: blur(6px);
    color: var(--fg);
    font-size: 0.65rem;
    pointer-events: none;
    z-index: 2;
  }

  .mods-banner {
    display: grid;
    gap: 32px;
    padding: clamp(24px, 4vw, 48px);
    overflow: hidden;
    position: relative;
  }
  .mods-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 100% 50%, var(--accent-soft), transparent 70%);
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .mods-banner {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
  .mods-banner__copy {
    display: grid;
    gap: 20px;
    justify-items: start;
    position: relative;
  }
  .mods-banner__stat {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--bg-2);
    transition: border-color 0.3s;
  }
  .mods-banner__stat:hover {
    border-color: var(--accent);
  }
  .mods-banner__stat :global(.mods-banner__logo) {
    width: 110px;
    height: auto;
    opacity: 0.9;
  }
  .mods-banner__num {
    font-size: clamp(4.5rem, 10vw, 7.5rem);
    line-height: 0.85;
  }

  .more {
    margin-top: 40px;
    display: grid;
    gap: 12px;
  }
  .more__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .more__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 32px;
    }
  }
  .more__list a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    transition: color 0.2s;
  }
  .more__list a:hover {
    color: var(--accent);
  }
</style>
