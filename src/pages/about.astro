---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { SITE, SOCIALS } from '../data/site';
import portrait from '../assets/about/graduation.jpg';

const log = [
  {
    year: '2026',
    items: [
      { text: 'Shipped Directive 8020 with Supermassive Games — my first AAA credit', href: '/directive-8020/' },
      { text: 'Production Lead and company director for VRLAN 2026 in the Netherlands', href: '/vrlan-2026/' },
      { text: 'Released Source2All Sensitivity Converter and QuickClip', href: '/software/' },
    ],
  },
  {
    year: '2025',
    items: [
      { text: 'Graduated from Futureworks with first-class honours in Games Design' },
      { text: 'Goldrush: Revived, BetterPUGs and the WMMR scoreboard for MORDHAU', href: '/games/#mods' },
    ],
  },
  {
    year: '2024',
    items: [
      { text: 'Released LUNARBALL on Steam', href: '/lunarball/' },
      { text: 'Led production at VRLAN 2024, including the first public broadcast of Orion Drift', href: '/vrlan-2024/' },
      { text: "Released swiift's Comp Mod and the battle royale map packs", href: '/games/#mods' },
    ],
  },
  {
    year: '2023',
    items: [
      { text: 'Rebuilt the broadcast package from scratch for Duckman LAN 2', href: '/duckman-lan-2023/' },
      { text: 'Ported Chivalry weapons into Hellsplit Arena', href: '/chivalry-mw-weapon-ports/' },
    ],
  },
  {
    year: '2022',
    items: [
      { text: 'Produced and presented the broadcast for Duckman LAN, Europe’s first community Echo Arena LAN', href: '/duckman-lan-2022/' },
      { text: 'First MORDHAU mods: Hijacked and Highrise', href: '/cod-to-mordhau-map-ports/' },
    ],
  },
  {
    year: '2021',
    items: [{ text: 'Built the Broadcast Tool for the first Redshift Contender Series', href: '/broadcast-tool/' }],
  },
];
---

<Base title="About" description="Owen Bladen-Kay — aka swiift — writes code for Unreal Engine games and bespoke software. Based in Manchester, UK.">
  <section class="about container">
    <div class="about__intro">
      <p class="eyebrow" data-reveal><span class="eyebrow__index">04</span><span class="eyebrow__rule"></span>About</p>
      <h1 class="display h1 about__title" data-reveal style="--i:1">Hello world!</h1>
      <div class="prose about__bio" data-reveal style="--i:2">
        <p class="lede">My name's Owen, also known as <strong>swiift</strong>.</p>
        <p>
          I write code for Unreal Engine games and bespoke software. Most recently I worked on <a href="/directive-8020/">Directive 8020</a>
          with Supermassive Games. Before that I released my own game, <a href="/lunarball/">LUNARBALL</a>, on Steam, and I've made a number of
          <a href="/games/#mods">MORDHAU mods</a>.
        </p>
        <p>
          I was also Production Lead at <a href="https://vr-lan.com" target="_blank" rel="noopener">VRLAN</a>, a community-focused event for
          competitive virtual reality players, producing its broadcasts from 2022 to 2026.
        </p>
        <p>I graduated from Futureworks in 2025 with first-class honours in Games Design.</p>
        <p>
          I'm always looking for new projects and people to work with, so if you have anything in mind, please
          <a href="#contact">get in touch</a>.
        </p>
      </div>
    </div>

    <!-- Player card -->
    <div class="card-wrap" data-reveal="fade" style="--i:2">
      <div class="player" data-tilt="10">
        <div class="player__photo">
          <Image src={portrait} alt="Owen Bladen-Kay smiling in his graduation cap and gown, holding his degree scroll." widths={[400, 640, 900]} sizes="(min-width: 1000px) 420px, 90vw" loading="eager" />
        </div>
        <div class="player__sheen" aria-hidden="true"></div>
        <div class="player__top">
          <Logo size={26} />
        </div>
        <div class="player__plate">
          <p class="player__tag mono">swiift</p>
          <p class="player__name display">Owen Bladen-Kay</p>
          <dl class="player__stats">
            <div><dt class="mono">Role</dt><dd>Programmer</dd></div>
            <div><dt class="mono">Engine</dt><dd>Unreal</dd></div>
            <div><dt class="mono">Based in</dt><dd>Manchester</dd></div>
            <div><dt class="mono">Degree</dt><dd>First-class</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Career log -->
  <section class="section container" aria-labelledby="log-title">
    <div class="section-head">
      <p class="eyebrow" data-reveal><span class="eyebrow__index">01</span><span class="eyebrow__rule"></span>Timeline</p>
      <h2 id="log-title" class="display h2" data-reveal style="--i:1">Experience</h2>
    </div>
    <ol role="list" class="log">
      {
        log.map((y, i) => (
          <li class="log__year" data-reveal style={`--i:${i % 3}`}>
            <span class="log__label display">{y.year}</span>
            <ul role="list" class="log__items">
              {y.items.map((it) => (
                <li>
                  {it.href ? (
                    <a href={it.href}>
                      {it.text} <Icon name="arrow" size={14} />
                    </a>
                  ) : (
                    <span>{it.text}</span>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Elsewhere -->
  <section class="container section--tight" aria-labelledby="links-title">
    <div class="links-grid">
      <div>
        <p class="eyebrow" data-reveal><span class="eyebrow__index">02</span><span class="eyebrow__rule"></span>Links</p>
        <h2 id="links-title" class="display h2" data-reveal style="--i:1">Contact</h2>
        <p class="lede" data-reveal style="--i:2">
          Email is best for work enquiries. I'm also <span class="accent">swiift.</span> on Discord.
        </p>
        <div class="btn-row" data-reveal style="--i:3">
          <a class="btn btn--primary" href={`mailto:${SITE.email}`} data-magnetic><Icon name="mail" /> Email me</a>
          <a class="btn btn--ghost" href="/melee-slashers/">Melee slashers guide</a>
        </div>
      </div>
      <ul role="list" class="tiles">
        {
          SOCIALS.map((s, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="tile panel" href={s.href} target="_blank" rel="noopener" data-tilt="6">
                <Icon name={s.icon} size={26} />
                <span class="tile__label">{s.label}</span>
                <span class="tile__handle mono">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 56px;
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 110px));
    align-items: start;
  }
  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 1fr) 420px;
      gap: clamp(48px, 7vw, 120px);
    }
  }
  .about__intro {
    display: grid;
    gap: 28px;
  }
  .about__bio p:not(.lede) {
    font-size: 1.1rem;
  }

  /* ---------- player card ---------- */
  .card-wrap {
    perspective: 1000px;
    justify-self: center;
    width: min(100%, 420px);
  }
  .player {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 30%;
    position: relative;
    aspect-ratio: 3 / 4.2;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--line));
    background: var(--panel);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
    box-shadow:
      0 50px 100px -40px color-mix(in oklab, var(--accent) 45%, transparent),
      0 0 0 6px var(--bg-2),
      0 0 0 7px var(--line-2);
  }
  .player__photo,
  .player__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .player__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(7 8 11 / 0.92) 82%);
  }
  .player__sheen {
    position: absolute;
    inset: 0;
    mix-blend-mode: color-dodge;
    opacity: 0.0;
    background:
      radial-gradient(500px circle at var(--mx) var(--my), rgb(255 255 255 / 0.35), transparent 40%),
      linear-gradient(115deg, transparent 20%, rgb(0 177 255 / 0.45) 35%, rgb(255 80 200 / 0.35) 50%, rgb(255 220 120 / 0.35) 65%, transparent 80%);
    background-size: 100% 100%, 250% 250%;
    background-position: center, calc(var(--mx) * 1.2) calc(var(--my) * 1.2);
    transition: opacity 0.4s;
  }
  .player:hover .player__sheen {
    opacity: 0.55;
  }
  .player__top {
    position: absolute;
    inset: 16px 16px auto 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--fg);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
  }
  .player__plate {
    position: absolute;
    inset: auto 0 0 0;
    padding: 22px 22px 20px;
    transform: translateZ(40px);
  }
  .player__tag {
    color: var(--accent);
  }
  .player__name {
    font-size: 2.6rem;
    line-height: 0.9;
    margin: 4px 0 16px;
  }
  .player__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-2);
    padding-top: 12px;
    gap: 8px;
  }
  .player__stats dt {
    font-size: 0.58rem;
    color: var(--muted);
  }
  .player__stats dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    line-height: 1.1;
  }

  /* ---------- log ---------- */
  .log {
    display: grid;
    border-top: 1px solid var(--line-2);
  }
  .log__year {
    display: grid;
    gap: 12px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .log__year {
      grid-template-columns: 200px 1fr;
      gap: 32px;
    }
  }
  .log__label {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    color: var(--accent);
  }
  .log__items {
    display: grid;
    gap: 10px;
    align-content: center;
  }
  .log__items li {
    position: relative;
    padding-left: 22px;
    color: var(--fg-2);
    font-size: 1.05rem;
  }
  .log__items li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .log__items a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }
  .log__items a:hover {
    color: var(--fg);
  }
  .log__items a :global(svg) {
    opacity: 0;
    transform: translateX(-4px);
    transition: 0.3s var(--ease-out);
    color: var(--accent);
  }
  .log__items a:hover :global(svg) {
    opacity: 1;
    transform: none;
  }

  /* ---------- links ---------- */
  .links-grid {
    display: grid;
    gap: 40px;
  }
  .links-grid > div {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  @media (min-width: 1000px) {
    .links-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 600px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile {
    --rx: 0deg;
    --ry: 0deg;
    display: grid;
    gap: 6px;
    padding: 18px;
    height: 100%;
    transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.5s var(--ease-out),
      border-color 0.3s,
      color 0.3s;
  }
  .tile:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tile__label {
    font-weight: 700;
    color: var(--fg);
    margin-top: 10px;
  }
  .tile__handle {
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
</style>
